#!/bin/bash

set -u

PROFILE="${INKYPI_WIFI_PROFILE:-preconfigured}"
STATE_DIR="/var/lib/inkypi-network-watchdog"
FAILURE_FILE="$STATE_DIR/failures"
OUTAGE_FILE="$STATE_DIR/outage-start"
RESTART_FILE="$STATE_DIR/last-network-restart"

log() {
  logger -t inkypi-network-watchdog "$1"
}

failure_count() {
  if [[ -f "$FAILURE_FILE" ]]; then
    cat "$FAILURE_FILE"
  else
    echo 0
  fi
}

record_failure() {
  local failures
  failures=$(( $(failure_count) + 1 ))
  echo "$failures" > "$FAILURE_FILE"
  if [[ ! -f "$OUTAGE_FILE" ]]; then
    date +%s > "$OUTAGE_FILE"
  fi
  echo "$failures"
}

gateway_is_reachable() {
  local gateway
  gateway=$(ip route show default dev wlan0 | awk 'NR == 1 {print $3}')
  [[ -n "$gateway" ]] && ping -I wlan0 -c 1 -W 2 "$gateway" >/dev/null 2>&1
}

reset_failures() {
  rm -f "$FAILURE_FILE" "$OUTAGE_FILE"
}

record_network_restart() {
  date +%s > "$RESTART_FILE"
}

if gateway_is_reachable; then
  reset_failures
  exit 0
fi

failures=$(record_failure)
log "Gateway unreachable on wlan0 (consecutive failure ${failures}); reconnecting ${PROFILE}."
record_network_restart
nmcli device disconnect wlan0 >/dev/null 2>&1 || true
sleep 2
nmcli connection up "$PROFILE" ifname wlan0 >/dev/null 2>&1 || true
sleep 15

if gateway_is_reachable; then
  log "Wi-Fi connectivity restored after reconnecting ${PROFILE}."
  reset_failures
  exit 0
fi

if (( failures >= 2 )); then
  log "Wi-Fi reconnect failed; restarting NetworkManager."
  record_network_restart
  systemctl restart NetworkManager
  sleep 20
  if gateway_is_reachable; then
    log "Wi-Fi connectivity restored after restarting NetworkManager."
    reset_failures
    exit 0
  fi
fi

exit 0
